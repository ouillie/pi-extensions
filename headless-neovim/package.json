{
  "name": "headless-neovim",
  "version": "0.0.0",
  "type": "module",
  "description": "A tiny Pi extension using headless Neovim for Vim keybindings in the prompt editor",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test *.test.ts",
    "check": "tsc --noEmit",
    "fix": "gts fix '**/*.ts'"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
