{
  "name": "pi-headless-neovim",
  "version": "0.0.0",
  "type": "module",
  "description": "A tiny Pi extension using headless Neovim for Vim keybindings in the prompt editor",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test index.test.ts",
    "check": "tsc --noEmit",
    "fix": "gts fix '**/*.ts'"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "gts": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
